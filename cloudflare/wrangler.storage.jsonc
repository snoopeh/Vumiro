{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Existing Durable Object owner: retain this name and migrations to preserve data.
  "name": "screentask-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "CALL_ROOMS", "class_name": "CallRoom" }, { "name": "FRIEND_DIRECTORY", "class_name": "FriendDirectory" }, { "name": "DIRECT_CONVERSATIONS", "class_name": "DirectConversation" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallRoom"] }, { "tag": "v2", "new_sqlite_classes": ["FriendDirectory"] }, { "tag": "v3", "new_sqlite_classes": ["DirectConversation"] }]
}
