{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vumiro-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "ratelimits": [{ "name": "ACCOUNT_API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "triggers": { "crons": ["0 * * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "ACCOUNT_DB", "database_name": "vumiro-account-data", "database_id": "eac4972c-d270-4931-8308-59fc851337f8", "migrations_dir": "migrations" }],
  // Reuse the existing namespaces directly, without a proxy request or data migration.
  "durable_objects": { "bindings": [{ "name": "CALL_ROOMS", "class_name": "CallRoom", "script_name": "screentask-rooms" }, { "name": "FRIEND_DIRECTORY", "class_name": "FriendDirectory", "script_name": "screentask-rooms" }, { "name": "DIRECT_CONVERSATIONS", "class_name": "DirectConversation", "script_name": "screentask-rooms" }] }
}
