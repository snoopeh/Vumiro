<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Vumiro</AssemblyName><RootNamespace>Vumiro.Client</RootNamespace><Version>1.22.4</Version>
    <Product>Vumiro</Product><Title>Vumiro</Title><Description>Share your view.</Description>
    <ApplicationIcon>Brand/vumiro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../vendor/windows/wintun.dll" LogicalName="Vumiro.Gaming.Wintun" />
    <EmbeddedResource Include="../vendor/windows/ViGEmBus_1.22.0.exe" LogicalName="Vumiro.Gaming.ControllerInstaller" />
    <EmbeddedResource Include="$(PkgNefarius_ViGEm_Client)/lib/netstandard2.0/Nefarius.ViGEm.Client.dll" LogicalName="Vumiro.Gaming.ViGEmClient" />
    <EmbeddedResource Include="Brand/vumiro.ico" LogicalName="Vumiro.DesktopIcon" />
    <ProjectReference Include="../Vumiro.Client.Updater/Vumiro.Client.Updater.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Content Include="WebServer/*.html;WebServer/*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyUpdaterForLocalLaunch" AfterTargets="Build">
    <MSBuild Projects="../Vumiro.Client.Updater/Vumiro.Client.Updater.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_VumiroUpdaterPath" />
    </MSBuild>
    <Copy SourceFiles="@(_VumiroUpdaterPath);@(_VumiroUpdaterPath->'%(FullPath).config')" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
